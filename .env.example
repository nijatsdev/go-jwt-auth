# Application Configuration
PORT=8080
APP_ENV=local
LOG_LEVEL=debug

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=go_jwt
DB_USERNAME=postgres
DB_PASSWORD=password
DB_SCHEMA=public

# JWT Configuration
JWT_SECRET=your-jwt-secret-min-32-chars

# Token Configuration
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
MAX_ACTIVE_REFRESH_TOKENS_PER_USER=10

# Token Cleanup Configuration
EXPIRED_TOKEN_RETENTION_DAYS=30
REVOKED_TOKEN_RETENTION_DAYS=90

# Database Migration Configuration
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgres://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?sslmode=disable&search_path=$DB_SCHEMA"
GOOSE_MIGRATION_DIR=migrations
GOOSE_TABLE=migrations